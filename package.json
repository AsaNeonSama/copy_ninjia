{
  "name": "copy_ninjia",
  "module": "index.ts",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "license": "MIT",
  "scripts": {
    "start": "bun run index.ts",
    "build": "bun scripts/build.ts",
    "lint": "eslint .",
    "lint:fast": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "check:install-script-syntax": "bun scripts/checkInstallScriptSyntax.ts",
    "check:install-isolation": "bun scripts/checkInstallIsolation.ts",
    "check:conventions": "bun scripts/checkProjectConventions.ts",
    "check:coverage": "bun scripts/checkCoverageMetrics.ts",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --randomize --coverage --coverage-reporter=text",
    "test:fault-injection": "bun scripts/testFaultInjection.ts",
    "perf:full": "bun scripts/perf/fullSuite.ts",
    "perf:review": "bun scripts/perf/review.ts",
    "perf:hot-paths": "bun scripts/perf/isolatedHotPath.ts",
    "perf:disk-transport": "bun scripts/perf/diskTransport.ts",
    "perf:hot-path-gate": "bun scripts/perf/hotPathProfileGate.ts",
    "perf:identity-database": "bun scripts/perf/identityDatabase.ts",
    "perf:join-log": "bun scripts/perf/joinLog.ts",
    "typecheck": "bun --check",
    "check": "bun run check:install-script-syntax && bun run check:install-isolation && bun run check:conventions && bun run lint && bun run typecheck && bun run test:coverage && bun run perf:hot-path-gate",
    "release:check": "bun scripts/release.ts check",
    "release:build": "bun scripts/release.ts build",
    "release:verify": "bun scripts/release.ts verify",
    "release:publish": "bun scripts/release.ts publish",
    "audit:release": "bun audit --audit-level=moderate",
    "migrate:wed-member-window": "bun scripts/migrateWedMemberWindow.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@grammyjs/runner": "^2.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "1.4.3",
    "detect-libc": "^2.1.2",
    "eslint": "^10.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@audio/encode-opus": "1.3.2",
    "@google-cloud/translate": "^10.2.0",
    "@google/genai": "^2.28.0",
    "@grammyjs/files": "^1.2.0",
    "drizzle-orm": "0.45.4",
    "grammy": "^1.46.0",
    "openai": "^7.32.0"
  }
}
